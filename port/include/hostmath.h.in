#ifndef PORT_HOSTMATH_H
#define PORT_HOSTMATH_H
/* Generated by CMake from hostmath.h.in. Do not edit.
 * Includes the HOST <math.h> by absolute path so port/shim/math.h can bypass
 * the N64 include/math.h, which sits earlier on the include path and would
 * otherwise satisfy libc++'s <cmath> (which then fails its own
 * "did I get the C++ standard library's math.h" check). */
#include "@PORT_HOST_MATH_H@"
#endif
